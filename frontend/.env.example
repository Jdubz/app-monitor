# Frontend Environment Configuration Example
# Copy this file to .env.development and .env.production and update values

# API Base URL (empty string in production means use same host)
VITE_API_BASE_URL=http://localhost:5000

# API Key for backend authentication
VITE_API_KEY=your-api-key-here

# Frontend password protection
# IMPORTANT: Set this to a strong password in production
# In CI/CD, this should be set via GitHub Secrets (VITE_PASSWORD)
VITE_PASSWORD=change-this-secure-password
