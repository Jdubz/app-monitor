{
  "dev-bots": {
    "artifactRoot": "shared/logs",
    "streams": {
      "stdout": {
        "pattern": "bot-*{taskId}*.log",
        "label": "Worker log (stdout/stderr combined)",
        "encoding": "utf-8"
      },
      "stderr": {
        "pattern": "bot-*{taskId}*.log",
        "label": "Worker log (stdout/stderr combined)",
        "encoding": "utf-8"
      }
    }
  }
}
