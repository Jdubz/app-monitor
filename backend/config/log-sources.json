{
  "version": "1.0",
  "logSources": {
    "app-monitor-backend": {
      "name": "App Monitor Backend",
      "enabled": true,
      "path": "../logs/backend.log",
      "format": "structured",
      "color": "#00D9FF",
      "parser": "winston",
      "displayOrder": 1
    },
    "app-monitor-frontend": {
      "name": "App Monitor Frontend",
      "enabled": true,
      "path": "../logs/frontend.log",
      "format": "vite",
      "color": "#646CFF",
      "parser": "vite",
      "displayOrder": 2
    },
    "job-finder-backend": {
      "name": "Job Finder Backend",
      "enabled": true,
      "path": "../../job-finder-BE/logs/backend-dev.log",
      "format": "structured",
      "color": "#F97316",
      "parser": "winston",
      "displayOrder": 3
    },
    "job-finder-frontend": {
      "name": "Job Finder Frontend",
      "enabled": true,
      "path": "../../job-finder-FE/logs/frontend-dev.log",
      "format": "vite",
      "color": "#61DAFB",
      "parser": "vite",
      "displayOrder": 4
    },
    "job-finder-worker": {
      "name": "Job Finder Worker",
      "enabled": true,
      "path": "../../job-finder-worker/logs/worker.log",
      "format": "python",
      "color": "#3776AB",
      "parser": "python-logging",
      "displayOrder": 5
    },
    "dev-bots": {
      "name": "Dev Bots",
      "enabled": false,
      "path": "../dev-bots/logs/dev-bots.log",
      "format": "structured",
      "color": "#805AD5",
      "parser": "winston",
      "displayOrder": 6,
      "note": "Enable after Phase B (dev-bots integration)"
    }
  },
  "globalSettings": {
    "maxLogLines": 5000,
    "tailLines": 500,
    "updateInterval": 100,
    "enableTimestampParsing": true,
    "enableLevelParsing": true
  }
}
