{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Context Recipe Schema",
  "description": "JSON Schema for validating context recipe YAML files",
  "type": "object",
  "required": ["profile", "version", "description", "taskTypes", "sources"],
  "properties": {
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 2,
      "maxLength": 50,
      "description": "Unique profile identifier (lowercase, alphanumeric, hyphens)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 1.0.0)"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "Human-readable description of the recipe's purpose"
    },
    "taskTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["implementation", "fix", "review", "deployment", "pr-follow-up", "analysis"]
      },
      "description": "Task types this recipe applies to"
    },
    "required": {
      "type": "boolean",
      "description": "Whether this recipe is required for the task type"
    },
    "sizeLimit": {
      "type": "object",
      "properties": {
        "maxBytes": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1000000,
          "description": "Maximum total bytes for the profile content"
        },
        "maxInlineBytes": {
          "type": "integer",
          "minimum": 100,
          "maximum": 100000,
          "description": "Maximum bytes for inline content display"
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 10
      },
      "description": "List of operational constraints and forbidden actions"
    },
    "investigationSteps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 10
      },
      "description": "Steps to investigate when using this context"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/source"
      },
      "description": "List of content sources to include"
    },
    "outputs": {
      "type": "object",
      "required": ["format", "filename"],
      "properties": {
        "format": {
          "type": "string",
          "enum": ["markdown", "json", "text", "yaml"]
        },
        "filename": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.(md|json|txt|yaml)$"
        },
        "includeMetadata": {
          "type": "boolean"
        }
      }
    },
    "ttl": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800,
      "description": "Time to live in seconds (max 7 days)"
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["code", "markdown", "json", "yaml", "config", "text"]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the source file"
        },
        "optional": {
          "type": "boolean",
          "description": "Whether this source is optional"
        },
        "extract": {
          "$ref": "#/definitions/extraction"
        },
        "transform": {
          "type": "string",
          "enum": ["none", "summarize", "strip-comments", "minify", "bullet-list"]
        }
      }
    },
    "extraction": {
      "type": "object",
      "properties": {
        "headings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extract specific markdown headings"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extract specific code sections (functions, classes)"
        },
        "codeBlocks": {
          "type": "boolean",
          "description": "Extract only code blocks"
        },
        "tables": {
          "type": "boolean",
          "description": "Extract only tables"
        },
        "jsonPath": {
          "type": "string",
          "pattern": "^\\$\\.",
          "description": "JSONPath expression (e.g., $.scripts)"
        }
      }
    }
  }
}
