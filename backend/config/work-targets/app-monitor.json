{
  "projectId": "app-monitor",
  "workTarget": "app-monitor",
  "displayName": "App Monitor",
  "projectRootEnv": "APP_MONITOR_ROOT",
  "defaultRoot": "../../..",
  "logSources": [
    {
      "id": "app-monitor-backend",
      "name": "App Monitor Backend",
      "enabled": true,
      "path": "logs/backend.log",
      "format": "structured",
      "color": "#00D9FF",
      "parser": "winston",
      "displayOrder": 1
    },
    {
      "id": "app-monitor-frontend",
      "name": "App Monitor Frontend",
      "enabled": true,
      "path": "logs/frontend.log",
      "format": "vite",
      "color": "#646CFF",
      "parser": "vite",
      "displayOrder": 2
    }
  ]
}
