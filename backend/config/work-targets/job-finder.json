{
  "projectId": "job-finder",
  "workTarget": "job-finder",
  "displayName": "Job Finder",
  "projectRootEnv": "JOB_FINDER_ROOT",
  "defaultRoot": "../../../../job-finder",
  "logSources": [
    {
      "id": "job-finder-backend",
      "name": "Job Finder Backend",
      "enabled": true,
      "path": "job-finder-BE/logs/backend.log",
      "envPathVar": "JOB_FINDER_BE_LOG_PATH",
      "format": "structured",
      "color": "#F97316",
      "parser": "winston",
      "displayOrder": 3
    },
    {
      "id": "job-finder-frontend",
      "name": "Job Finder Frontend",
      "enabled": true,
      "path": "job-finder-FE/logs/frontend.log",
      "envPathVar": "JOB_FINDER_FE_LOG_PATH",
      "format": "vite",
      "color": "#61DAFB",
      "parser": "vite",
      "displayOrder": 4
    },
    {
      "id": "job-finder-worker",
      "name": "Job Finder Worker",
      "enabled": true,
      "path": "job-finder-worker/logs/worker.log",
      "envPathVar": "JOB_FINDER_WORKER_LOG_PATH",
      "format": "python",
      "color": "#3776AB",
      "parser": "python-logging",
      "displayOrder": 5
    }
  ]
}
