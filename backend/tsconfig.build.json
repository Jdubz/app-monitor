{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true
  },
  "references": [
    { "path": "../packages/api-contracts" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
