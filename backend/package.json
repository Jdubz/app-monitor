{
  "name": "app-monitor-backend",
  "version": "1.0.0",
  "description": "Express backend for app monitor",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/safe-dev.sh",
    "build": "tsc --build tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "node safe-test-runner.cjs",
    "test:unit": "node safe-test-runner.cjs",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts --watch",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:unsafe": "vitest run --config vitest.unit.config.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "check": "node scripts/check-process.js && node scripts/check-port.js",
    "clean": "pkill -f 'nodemon.*app-monitor' 2>/dev/null || true",
    "stop": "pkill -f 'nodemon.*app-monitor' 2>/dev/null || true",
    "type-check": "tsc --project tsconfig.typecheck.json",
    "migrate": "node --loader ts-node/esm src/scripts/migrate.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "app-monitor"
  ],
  "author": "Job Finder App Manager",
  "license": "MIT",
  "dependencies": {
    "@app-monitor/api-contracts": "file:../shared/api-contracts",
    "@google-cloud/logging": "^11.2.1",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@types/uuid": "^10.0.0",
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "node-pty": "^1.0.0",
    "simple-git": "^3.30.0",
    "socket.io": "^4.6.1",
    "typescript": "5.3.3",
    "uuid": "^9.0.1",
    "yaml": "^2.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.46",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.25",
    "@types/supertest": "^6.0.3",
    "@types/tar-fs": "^2.0.4",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^9.39.1",
    "eslint-plugin-local-rules": "^3.0.2",
    "globals": "^16.5.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.47.0",
    "vitest": "^1.6.1"
  }
}
