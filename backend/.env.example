# =============================================================================
# App Monitor Backend - Environment Variables
# =============================================================================
# Copy this file to .env and update with your actual values
#

# -----------------------------------------------------------------------------
# API Authentication
# -----------------------------------------------------------------------------
API_KEY=your-secure-api-key-here-change-this
REQUIRE_AUTH=true

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5174

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_PATH=./data/app-monitor.db
# DB_PATH=./data/dev-bots.db  # Alternative path used in scripts

# -----------------------------------------------------------------------------
# GitHub Integration
# -----------------------------------------------------------------------------
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GH_TOKEN=ghp_your_github_token_here  # Alternative to GITHUB_TOKEN
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# -----------------------------------------------------------------------------
# DevBots Configuration
# -----------------------------------------------------------------------------
MAX_DEV_BOTS=3
MAX_LOG_STREAM_SUBSCRIBERS=5

# -----------------------------------------------------------------------------
# Interactive Sessions
# -----------------------------------------------------------------------------
INTERACTIVE_SESSION_OWNER=contact@joshwentworth.com
INTERACTIVE_PROD_APP_PATH=/opt/app-monitor
INTERACTIVE_PROD_API_BASE_URL=https://api.yourproduction.com
INTERACTIVE_PROD_API_TOKEN=your_production_api_token_here
INTERACTIVE_REPO_BRANCH=staging

# -----------------------------------------------------------------------------
# Production Configuration (fallbacks for interactive sessions)
# -----------------------------------------------------------------------------
PRODUCTION_API_BASE_URL=https://api.yourproduction.com
PRODUCTION_API_TOKEN=your_production_api_token_here
PRODUCTION_API_KEY=your_production_api_key_here

# -----------------------------------------------------------------------------
# Auto-Recovery System
# -----------------------------------------------------------------------------
ENABLE_AUTO_RECOVERY=false
RECOVERY_DRY_RUN=true
MAX_CONCURRENT_REPAIR_BOTS=1
RECOVERY_CLEANUP_TIMEOUT_MS=600000    # 10 minutes
RECOVERY_FOLLOWUP_TIMEOUT_MS=900000   # 15 minutes

# -----------------------------------------------------------------------------
# Google Cloud Platform (for Firebase/Cloud Storage)
# -----------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=./.firebase/serviceAccountKey.json
PROD_PROJECT_ID=static-sites-257923

# -----------------------------------------------------------------------------
# Testing & CI/CD
# -----------------------------------------------------------------------------
CI=false
FORCE_NATIVE_DB_TESTS=0

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info  # debug, info, warn, error

# -----------------------------------------------------------------------------
# User Information (for Docker containers)
# -----------------------------------------------------------------------------
USER=yourusername

# -----------------------------------------------------------------------------
# Home Directory Paths (usually auto-detected)
# -----------------------------------------------------------------------------
# HOME=/home/yourusername
# USERPROFILE=C:\Users\yourusername  # Windows

# =============================================================================
# NOTES
# =============================================================================
#
# Required Variables (must be set):
#   - GITHUB_TOKEN or GH_TOKEN: Required for GitHub API access
#   - API_KEY: Required for backend API authentication
#
# Optional Variables (have defaults):
#   - PORT: Defaults to 5000
#   - NODE_ENV: Defaults to 'development'
#   - MAX_DEV_BOTS: Defaults to 3
#   - RECOVERY_DRY_RUN: Defaults to true (safe mode)
#
# Production-Only Variables:
#   - GITHUB_WEBHOOK_SECRET: Only needed if using GitHub webhooks
#   - GOOGLE_APPLICATION_CREDENTIALS: Only needed for GCP features
#   - INTERACTIVE_* variables: Only for production interactive sessions
#
# =============================================================================
