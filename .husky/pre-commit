#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔒 Running pre-commit checks..."

# 1. Validate package locks (root)
echo "  → Validating root package-lock.json..."
npm run validate:locks || {
  echo ""
  echo "❌ Pre-commit check failed: Root package lock file out of sync"
  echo ""
  exit 1
}

# 2. Validate workspace lock files (deployment simulation)
echo "  → Validating workspace lock files (deployment simulation)..."
node scripts/validate-workspace-locks.cjs || {
  echo ""
  echo "❌ Pre-commit check failed: Workspace lock files out of sync"
  echo "   This would cause production deployment to FAIL!"
  echo ""
  exit 1
}

# 3. Check for package.json dependency changes without lock file changes
if git diff --cached --name-only | grep -q "package\.json$"; then
  # Check if dependencies/devDependencies sections changed
  if git diff --cached package.json | grep -qE '^\+.*"(dependencies|devDependencies|peerDependencies|optionalDependencies)"'; then
    if ! git diff --cached --name-only | grep -q "package-lock\.json$"; then
      echo ""
      echo "❌ package.json dependencies modified without corresponding package-lock.json"
      echo "   Run: npm install"
      echo ""
      exit 1
    fi
  fi
fi

# 4. Lint staged files
echo "  → Linting staged files..."
npx lint-staged

echo "✅ Pre-commit checks passed"
