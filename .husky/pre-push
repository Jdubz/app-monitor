#!/bin/sh

echo "🧪 Running app-monitor pre-push checks..."

# Clean up any stale lock files
rm -f backend/.test-lock frontend/.test-lock

# Run tests only for backend and frontend (skip dev-bots E2E tests)
NODE_OPTIONS='--max-old-space-size=2048' npm run test:backend || {
    echo "❌ Backend tests failed! Fix the failing tests before pushing."
    exit 1
}

NODE_OPTIONS='--max-old-space-size=2048' npm run test:frontend || {
    echo "❌ Frontend tests failed! Fix the failing tests before pushing."
    exit 1
}

echo "✅ App-monitor pre-push checks completed"
echo "ℹ️  Note: E2E tests (dev-bots) are skipped in pre-push hook"
