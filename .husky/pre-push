#!/bin/sh

echo "🔍 Running app-monitor pre-push quality checks (lint + tsc + unit tests)..."

# Validate package locks FIRST
echo ""
echo "📦 Validating package-lock.json files..."
npm run validate:locks || {
    echo "❌ Package lock files out of sync! Run npm install and commit lock files."
    exit 1
}

# Ensure legacy mirror directories are not present in the repo
if [ -d "dev-bots/mirror" ]; then
    echo "❌ Refusing to push with dev-bots/mirror present. Run 'rm -rf dev-bots/mirror' and retry."
    exit 1
fi

if find . -path "*/dev-bots/mirror/*" -print -quit | grep -q .; then
    echo "❌ Refusing to push: nested dev-bots/mirror paths detected."
    exit 1
fi

if [ -d "backend/dev-bots" ]; then
    echo "❌ Refusing to push with backend/dev-bots artifacts present. Run 'rm -rf backend/dev-bots' and retry."
    exit 1
fi

# Run linting for backend and frontend workspaces
npm run lint -w backend || {
    echo "❌ Backend linting failed! Please fix errors before pushing."
    exit 1
}

npm run lint -w frontend || {
    echo "❌ Frontend linting failed! Please fix errors before pushing."
    exit 1
}

echo ""
echo "🔧 Running TypeScript compilation checks..."
npm run build -w backend || {
    echo "❌ Backend TypeScript compilation failed! Please fix errors before pushing."
    exit 1
}

npx tsc --noEmit -p frontend/tsconfig.json || {
    echo "❌ Frontend TypeScript compilation failed! Please fix errors before pushing."
    exit 1
}

echo ""
echo "🧪 Running backend unit tests..."
CI=true npm run test:unit -w backend || {
    echo "❌ Backend unit tests failed! Please investigate before pushing."
    exit 1
}

echo ""
echo "🧪 Running frontend unit tests..."
CI=true npm run test:unit -w frontend || {
    echo "❌ Frontend unit tests failed! Please investigate before pushing."
    exit 1
}

echo ""
echo "✅ Pre-push quality checks completed successfully"
