# Shared Environment Configuration for App Monitor
# Copy this to .env and fill in your values

# API Authentication
API_KEY=your-api-key-here
REQUIRE_AUTH=false

# GitHub Integration
GITHUB_TOKEN=your-github-token-here

# Frontend Build-Time Variables (VITE_*)
VITE_PASSWORD=your-password-here
VITE_API_KEY=your-api-key-here
VITE_API_BASE_URL=http://localhost:5000

# Frontend Dev Server Proxy (used by vite.config.ts)
VITE_BACKEND_URL=http://localhost:5000

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5174

# Dev-Bot Configuration
MAX_DEV_BOTS=3
REPOSITORY_URL=https://github.com/yourusername/your-repo.git

# Recovery System
ENABLE_AUTO_RECOVERY=true
RECOVERY_DRY_RUN=false
MAX_CONCURRENT_REPAIR_BOTS=1
RECOVERY_CLEANUP_TIMEOUT_MS=600000
RECOVERY_FOLLOWUP_TIMEOUT_MS=900000
