[Unit]
Description=App Monitor Deployment Lock Health Monitor Timer
Documentation=https://github.com/Jdubz/app-monitor
Requires=deployment-lock-monitor.service

[Timer]
# Run every 5 minutes
OnBootSec=2min
OnUnitActiveSec=5min

# Ensure timer persists across reboots
Persistent=true

[Install]
WantedBy=timers.target
