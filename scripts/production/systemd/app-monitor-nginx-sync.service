[Unit]
Description=App Monitor Nginx Sync Check
Documentation=https://github.com/Jdubz/app-monitor
After=network.target nginx.service

[Service]
Type=oneshot
ExecStart=/opt/app-monitor/scripts/nginx-sync.sh
User=root
StandardOutput=journal
StandardError=journal

# Don't restart on failure - timer will handle scheduling
Restart=no
