[Unit]
Description=Periodic nginx sync check for App Monitor
Documentation=https://github.com/Jdubz/app-monitor

[Timer]
# Run every 5 minutes to detect and auto-fix port misalignment
OnBootSec=1min
OnUnitActiveSec=5min

# Add randomized delay to prevent thundering herd
RandomizedDelaySec=30

# Persist timer across reboots
Persistent=true

[Install]
WantedBy=timers.target
