# Sudoers configuration for GitHub Actions runner
# This allows the runner user to execute deployment commands without password
#
# Installation:
#   sudo cp scripts/production/sudoers-github-runner /etc/sudoers.d/github-runner-deploy
#   sudo chmod 0440 /etc/sudoers.d/github-runner-deploy
#   sudo visudo -c  # Verify syntax
#
# Replace 'runner-user' with actual GitHub runner username (usually 'runner' or your username)

# Allow runner to execute deployment script
runner-user ALL=(ALL) NOPASSWD: /opt/app-monitor/scripts/production/deploy.sh

# Allow runner to manage systemd services
runner-user ALL=(ALL) NOPASSWD: /bin/systemctl start app-monitor-backend@*
runner-user ALL=(ALL) NOPASSWD: /bin/systemctl stop app-monitor-backend@*
runner-user ALL=(ALL) NOPASSWD: /bin/systemctl restart app-monitor-backend@*
runner-user ALL=(ALL) NOPASSWD: /bin/systemctl status app-monitor-backend@*
runner-user ALL=(ALL) NOPASSWD: /bin/systemctl is-active app-monitor-backend@*
runner-user ALL=(ALL) NOPASSWD: /bin/systemctl start app-monitor-frontend.service
runner-user ALL=(ALL) NOPASSWD: /bin/systemctl stop app-monitor-frontend.service
runner-user ALL=(ALL) NOPASSWD: /bin/systemctl restart app-monitor-frontend.service
runner-user ALL=(ALL) NOPASSWD: /bin/systemctl status app-monitor-frontend.service
runner-user ALL=(ALL) NOPASSWD: /bin/systemctl is-active app-monitor-frontend.service
runner-user ALL=(ALL) NOPASSWD: /bin/systemctl reload nginx
runner-user ALL=(ALL) NOPASSWD: /bin/systemctl status nginx
runner-user ALL=(ALL) NOPASSWD: /bin/systemctl is-active nginx

# Allow runner to read logs
runner-user ALL=(ALL) NOPASSWD: /bin/journalctl -u app-monitor-backend@* --no-pager
runner-user ALL=(ALL) NOPASSWD: /bin/journalctl -u app-monitor-frontend.service --no-pager
