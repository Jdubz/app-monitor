{
  "name": "app-monitor-frontend",
  "version": "1.0.0",
  "description": "React frontend for dev console monitor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node safe-test-runner.cjs",
    "test:unit": "node safe-test-runner.cjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "node safe-test-runner.cjs",
    "test:watch": "vitest --config vitest.unit.config.ts --watch",
    "test:watch:integration": "vitest --config vitest.integration.config.ts --watch",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:coverage:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "test:coverage:all": "vitest run --coverage",
    "test:unsafe": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "dependencies": {
    "@app-monitor/api-contracts": "file:../packages/api-contracts",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.0.6",
    "@radix-ui/react-separator": "^1.0.4",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.6.5",
    "lucide-react": "^0.453.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.4",
    "socket.io-client": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^23.2.0",
    "postcss": "^8.4.41",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^3.4.14",
    "typescript": "5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.6.1"
  }
}
