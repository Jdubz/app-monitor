/**
 * Tests for Retry API Endpoints
 */

import { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';
import request from 'supertest';
import express from 'express';

// Mock the claudeWorkersManager using vi.hoisted
const mockClaudeWorkersManager = vi.hoisted(() => ({
  retryTask: vi.fn(),
  cancelRetry: vi.fn(),
  getRetryInfo: vi.fn(),
  getRetryStats: vi.fn(),
  updateRetryConfig: vi.fn(),
  getTasks: vi.fn()
}));

// Mock the entire api module to prevent real initialization
vi.mock('./api.js', () => ({
  claudeWorkersManager: mockClaudeWorkersManager,
  default: vi.fn(() => ({
    use: vi.fn(),
    post: vi.fn(),
    get: vi.fn(),
    put: vi.fn(),
    delete: vi.fn()
  }))
}));

import router from './api.js';

describe.skip('Retry API Endpoints', () => {
  let app: express.Application;

  beforeEach(() => {
    app = express();
    app.use(express.json());
    app.use('/api', router);
    vi.clearAllMocks();
  });

  afterEach(() => {
    vi.clearAllMocks();
  });

  describe('POST /api/claude-workers/tasks/:taskId/retry', () => {
    it('should retry a task successfully', { timeout: 5000 }, async () => {
      mockClaudeWorkersManager.retryTask.mockResolvedValue({
        success: true,
        message: 'Task scheduled for retry'
      });

      const response = await request(app)
        .post('/api/claude-workers/tasks/test-task-1/retry')
        .send({ reason: 'Manual retry' })
        .expect(200);

      expect(response.body).toEqual({
        success: true,
        message: 'Task scheduled for retry'
      });
      expect(mockClaudeWorkersManager.retryTask).toHaveBeenCalledWith('test-task-1', 'Manual retry');
    });

    it('should handle retry failure', { timeout: 5000 }, async () => {
      mockClaudeWorkersManager.retryTask.mockResolvedValue({
        success: false,
        message: 'Task cannot be retried'
      });

      const response = await request(app)
        .post('/api/claude-workers/tasks/test-task-1/retry')
        .send({ reason: 'Manual retry' })
        .expect(400);

      expect(response.body).toEqual({
        success: false,
        error: 'Task cannot be retried'
      });
    });

    it('should handle server errors', { timeout: 5000 }, async () => {
      mockClaudeWorkersManager.retryTask.mockRejectedValue(new Error('Database error'));

      const response = await request(app)
        .post('/api/claude-workers/tasks/test-task-1/retry')
        .send({ reason: 'Manual retry' })
        .expect(500);

      expect(response.body).toHaveProperty('error', 'Failed to retry task');
      expect(response.body).toHaveProperty('message', 'Database error');
    });
  });

  describe('POST /api/claude-workers/tasks/:taskId/cancel-retry', () => {
    it('should cancel retry successfully', { timeout: 5000 }, async () => {
      mockClaudeWorkersManager.cancelRetry.mockReturnValue({
        success: true,
        message: 'Retry cancelled successfully'
      });

      const response = await request(app)
        .post('/api/claude-workers/tasks/test-task-1/cancel-retry')
        .expect(200);

      expect(response.body).toEqual({
        success: true,
        message: 'Retry cancelled successfully'
      });
      expect(mockClaudeWorkersManager.cancelRetry).toHaveBeenCalledWith('test-task-1');
    });

    it('should handle cancel retry failure', { timeout: 5000 }, async () => {
      mockClaudeWorkersManager.cancelRetry.mockReturnValue({
        success: false,
        message: 'No scheduled retry found for this task'
      });

      const response = await request(app)
        .post('/api/claude-workers/tasks/test-task-1/cancel-retry')
        .expect(400);

      expect(response.body).toEqual({
        success: false,
        error: 'No scheduled retry found for this task'
      });
    });
  });

  describe('GET /api/claude-workers/tasks/:taskId/retry-info', () => {
    it('should return retry information', { timeout: 5000 }, async () => {
      const mockRetryInfo = {
        canRetry: true,
        retryCount: 1,
        maxRetries: 3,
        retryHistory: [
          {
            attemptNumber: 1,
            timestamp: '2024-01-01T00:00:00Z',
            reason: 'Automatic retry',
            error: 'Connection timeout'
          }
        ],
        scheduledRetries: []
      };

      mockClaudeWorkersManager.getRetryInfo.mockReturnValue(mockRetryInfo);

      const response = await request(app)
        .get('/api/claude-workers/tasks/test-task-1/retry-info')
        .expect(200);

      expect(response.body).toEqual(mockRetryInfo);
      expect(mockClaudeWorkersManager.getRetryInfo).toHaveBeenCalledWith('test-task-1');
    });

    it('should handle server errors', { timeout: 5000 }, async () => {
      mockClaudeWorkersManager.getRetryInfo.mockImplementation(() => {
        throw new Error('Database error');
      });

      const response = await request(app)
        .get('/api/claude-workers/tasks/test-task-1/retry-info')
        .expect(500);

      expect(response.body).toHaveProperty('error', 'Failed to get retry information');
      expect(response.body).toHaveProperty('message', 'Database error');
    });
  });

  describe('GET /api/claude-workers/retry-stats', () => {
    it('should return retry statistics', { timeout: 5000 }, async () => {
      const mockStats = {
        totalRetries: 10,
        successfulRetries: 8,
        failedRetries: 2,
        scheduledRetries: 1,
        retryConfig: {
          maxRetries: 3,
          baseDelay: 5000,
          strategy: 'exponential'
        }
      };

      mockClaudeWorkersManager.getRetryStats.mockReturnValue(mockStats);

      const response = await request(app)
        .get('/api/claude-workers/retry-stats')
        .expect(200);

      expect(response.body).toEqual(mockStats);
      expect(mockClaudeWorkersManager.getRetryStats).toHaveBeenCalled();
    });
  });

  describe('PUT /api/claude-workers/retry-config', () => {
    it('should update retry configuration', { timeout: 5000 }, async () => {
      const config = {
        maxRetries: 5,
        baseDelay: 10000,
        strategy: 'linear'
      };

      mockClaudeWorkersManager.updateRetryConfig.mockImplementation(() => {});

      const response = await request(app)
        .put('/api/claude-workers/retry-config')
        .send(config)
        .expect(200);

      expect(response.body).toEqual({
        success: true,
        message: 'Retry configuration updated successfully',
        config
      });
      expect(mockClaudeWorkersManager.updateRetryConfig).toHaveBeenCalledWith(config);
    });

    it('should handle server errors', { timeout: 5000 }, async () => {
      mockClaudeWorkersManager.updateRetryConfig.mockImplementation(() => {
        throw new Error('Configuration error');
      });

      const response = await request(app)
        .put('/api/claude-workers/retry-config')
        .send({ maxRetries: 5 })
        .expect(500);

      expect(response.body).toHaveProperty('error', 'Failed to update retry configuration');
      expect(response.body).toHaveProperty('message', 'Configuration error');
    });
  });

  describe('GET /api/claude-workers/tasks/failed/retryable', () => {
    it('should return retryable failed tasks', { timeout: 5000 }, async () => {
      const mockTasks = {
        pending: [],
        active: [],
        completed: [
          {
            id: 'task-1',
            status: 'failed',
            error: 'Connection timeout'
          },
          {
            id: 'task-2',
            status: 'failed',
            error: 'Permission denied'
          }
        ]
      };

      mockClaudeWorkersManager.getTasks.mockResolvedValue(mockTasks);
      mockClaudeWorkersManager.getRetryInfo
        .mockReturnValueOnce({ canRetry: true })  // task-1
        .mockReturnValueOnce({ canRetry: false }); // task-2

      const response = await request(app)
        .get('/api/claude-workers/tasks/failed/retryable')
        .expect(200);

      expect(response.body).toEqual({
        retryableTasks: [mockTasks.completed[0]],
        total: 1
      });
    });

    it('should handle server errors', { timeout: 5000 }, async () => {
      mockClaudeWorkersManager.getTasks.mockRejectedValue(new Error('Database error'));

      const response = await request(app)
        .get('/api/claude-workers/tasks/failed/retryable')
        .expect(500);

      expect(response.body).toHaveProperty('error', 'Failed to get retryable tasks');
      expect(response.body).toHaveProperty('message', 'Database error');
    });
  });
});
