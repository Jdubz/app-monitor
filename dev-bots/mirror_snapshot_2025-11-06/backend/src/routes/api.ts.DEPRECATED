/**
 * Get Socket.IO connection statistics
 */
router.get('/socket/stats', (_req: Request, res: Response) => {
  try {
    // Note: connectionManager will be imported from server
    const { connectionManager } = require('../server.js');
    const stats = connectionManager.getStats();
    
    res.json({
      success: true,
      stats
    });
  } catch (error) {
    logger.error({
      category: 'socket',
      action: 'get_stats_error',
      message: 'Failed to get connection stats',
      error
    });
    res.status(500).json({
      error: 'Failed to get connection statistics',
      message: error instanceof Error ? error.message : String(error)
    });
  }
});

/**
 * Get all active connections
 */
router.get('/socket/connections', (_req: Request, res: Response) => {
  try {
    const { connectionManager } = require('../server.js');
    const connections = connectionManager.getAllConnections();
    
    res.json({
      success: true,
      connections: connections.map((conn: any) => ({
        socketId: conn.socketId,
        connectedAt: conn.connectedAt,
        lastPing: conn.lastPing,
        isHealthy: conn.isHealthy,
        reconnectCount: conn.reconnectCount,
        subscriptions: Array.from(conn.subscriptions),
        monitors: Array.from(conn.monitors),
      })),
      count: connections.length
    });
  } catch (error) {
    logger.error({
      category: 'socket',
      action: 'get_connections_error',
      message: 'Failed to get connections',
      error
    });
    res.status(500).json({
      error: 'Failed to get connections',
      message: error instanceof Error ? error.message : String(error)
    });
  }
});

/**
 * Get specific connection info
 */
router.get('/socket/connections/:socketId', (req: Request, res: Response) => {
  try {
    const { socketId } = req.params;
    const { connectionManager } = require('../server.js');
    const info = connectionManager.getConnectionInfo(socketId);
    
    if (!info) {
      return res.status(404).json({
        error: 'Connection not found',
        socketId
      });
    }
    
    res.json({
      success: true,
      connection: {
        socketId: info.socketId,
        connectedAt: info.connectedAt,
        lastPing: info.lastPing,
        isHealthy: info.isHealthy,
        reconnectCount: info.reconnectCount,
        subscriptions: Array.from(info.subscriptions),
        monitors: Array.from(info.monitors),
      }
    });
  } catch (error) {
    logger.error({
      category: 'socket',
      action: 'get_connection_error',
      message: `Failed to get connection ${req.params.socketId}`,
      error
    });
    res.status(500).json({
      error: 'Failed to get connection info',
      message: error instanceof Error ? error.message : String(error)
    });
  }
});

