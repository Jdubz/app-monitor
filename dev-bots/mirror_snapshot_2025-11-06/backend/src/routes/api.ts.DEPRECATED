/**
 * Fail task
 */
router.post('/tasks/:taskId/fail', (req: Request, res: Response) => {
  try {
    const { taskId } = req.params;
    const { error: taskError, exitCode } = req.body;
    
    if (!taskError) {
      return res.status(400).json({
        error: 'Missing required field: error'
      });
    }
    
    const { taskQueueManager } = require('../server.js');
    // Use singleton taskQueueManager
    
    const task = taskQueueManager.failTask(taskId, taskError, exitCode);
    
    if (!task) {
      return res.status(404).json({
        error: 'Task not found',
        taskId
      });
    }
    
    res.json({
      success: true,
      task
    });
  } catch (error) {
    logger.error({
      category: 'process',
      action: 'fail_task_error',
      message: `Failed to mark task as failed ${req.params.taskId}`,
      error
    });
    res.status(400).json({
      error: 'Failed to mark task as failed',
      message: error instanceof Error ? error.message : String(error)
    });
  }
});

