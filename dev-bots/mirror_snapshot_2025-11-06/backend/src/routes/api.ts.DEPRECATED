import { Router, Request, Response } from 'express';
import { fileURLToPath } from 'url';
import { ProcessManager } from '../services/processManager.js';
import { CloudLogging } from '../services/cloudLogging.js';
import { ScriptManager } from '../services/scriptManager.js';
import { ClaudeWorkersManager } from '../services/claudeWorkersManager.js';
import { logger } from '../utils/logger.js';
import { getPortInfo, killPortProcess, getDockerContainerInfo, stopDockerContainer } from '../utils/portManager.js';
import { services } from '../config.js';
import { logRotation, logStreamer } from '../server.js';
import * as fs from 'fs';
import * as path from 'path';
import { spawn } from 'child_process';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

// Resolve logs directory relative to this file (routes -> src -> backend -> dev-monitor -> root -> logs)
const LOGS_DIR = path.resolve(__dirname, '../../../../logs');

const router = Router();
const processManager = new ProcessManager();
const cloudLogging = new CloudLogging();
const scriptManager = new ScriptManager();
const claudeWorkersManager = new ClaudeWorkersManager(processManager);

// Health check endpoint
router.get('/health', (_req: Request, res: Response) => {
  res.json({
    status: 'healthy',
    timestamp: new Date().toISOString(),
    uptime: process.uptime(),
  });
});

// Get status of all services
router.get('/services/status', async (_req: Request, res: Response) => {
  try {
    const statuses = await processManager.getAllStatuses();
    res.json(statuses);
  } catch (error) {
    logger.error({
      category: 'api',
      action: 'get_all_statuses_failed',
      message: 'Failed to get all service statuses',
      error
    });
    res.status(500).json({
      error: 'Failed to get service statuses',
      message: error instanceof Error ? error.message : String(error),
    });
  }
});

// Get status of a specific service
router.get('/services/:serviceName/status', async (req: Request, res: Response) => {
  try {
    const { serviceName } = req.params;
