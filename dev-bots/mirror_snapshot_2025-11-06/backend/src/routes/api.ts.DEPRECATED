/**
 * Assign task to worker
 */
router.post('/tasks/:taskId/assign', (req: Request, res: Response) => {
  try {
    const { taskId } = req.params;
    const { workerId, agentId } = req.body;
    
    if (!workerId || !agentId) {
      return res.status(400).json({
        error: 'Missing required fields',
        required: ['workerId', 'agentId']
      });
    }
    
    const { taskQueueManager } = require('../server.js');
    // Use singleton taskQueueManager
    
    const task = taskQueueManager.assignTask(taskId, workerId, agentId);
    
    if (!task) {
      return res.status(404).json({
        error: 'Task not found or cannot be assigned',
        taskId
      });
    }
    
    res.json({
      success: true,
      task
    });
  } catch (error) {
    logger.error({
      category: 'process',
      action: 'assign_task_error',
      message: `Failed to assign task ${req.params.taskId}`,
      error
    });
    res.status(400).json({
      error: 'Failed to assign task',
      message: error instanceof Error ? error.message : String(error)
    });
  }
});

