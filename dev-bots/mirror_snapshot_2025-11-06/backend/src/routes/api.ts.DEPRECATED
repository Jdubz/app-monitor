 */
router.post('/tasks/:taskId/retry', (req: Request, res: Response) => {
  try {
    const { taskId } = req.params;
    const { taskQueueManager } = require('../server.js');
    // Use singleton taskQueueManager
    
    const task = taskQueueManager.retryTask(taskId);
    
    if (!task) {
      return res.status(404).json({
        error: 'Task not found or cannot be retried',
        taskId
      });
    }
    
    res.json({
      success: true,
      task
    });
  } catch (error) {
    logger.error({
      category: 'process',
      action: 'retry_task_error',
      message: `Failed to retry task ${req.params.taskId}`,
      error
    });
    res.status(400).json({
      error: 'Failed to retry task',
      message: error instanceof Error ? error.message : String(error)
    });
  }
});

// ============================================================================
// Task Bridge Routes
// ============================================================================

/**
 * Get task bridge statistics
 */
router.get('/tasks/bridge/stats', (_req: Request, res: Response) => {
  try {
    const { taskBridge } = require('../server.js');
    const stats = taskBridge.getStats();
    
    res.json({
      success: true,
      stats
    });
  } catch (error) {
    logger.error({
      category: 'process',
      action: 'get_bridge_stats_error',
      message: 'Failed to get task bridge statistics',
      error
    });
    res.status(500).json({
      error: 'Failed to get bridge statistics',
      message: error instanceof Error ? error.message : String(error)
    });
  }
});

/**
 * Manually trigger task synchronization
 */
router.post('/tasks/bridge/sync', async (_req: Request, res: Response) => {
  try {
    const { taskBridge } = require('../server.js');
    await taskBridge.syncTasks();
    
    res.json({
      success: true,
      message: 'Tasks synchronized successfully'
    });
  } catch (error) {
    logger.error({
      category: 'process',
      action: 'sync_tasks_error',
      message: 'Failed to synchronize tasks',
      error
    });
    res.status(500).json({
      error: 'Failed to synchronize tasks',
      message: error instanceof Error ? error.message : String(error)
    });
  }
});

// Export the processManager, cloudLogging, scriptManager, and claudeWorkersManager instances for use in Socket.IO
export { processManager, cloudLogging, scriptManager, claudeWorkersManager };
export default router;
