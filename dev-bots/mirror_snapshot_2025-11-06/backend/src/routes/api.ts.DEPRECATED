// ============================================================================
// Docker Service-Specific Routes
// ============================================================================

// Start docker container
router.post('/services/:name/docker/start-container', async (req: Request, res: Response) => {
  const { name } = req.params;

  if (name !== 'python-worker') {
    res.status(400).json({ error: 'Docker operations only supported for python-worker' });
    return;
  }

  try {
    logger.info({
      category: 'api',
      action: 'starting_docker_container_for_name',
      message: `Starting docker container for ${name}`
    });
    const { execAsync } = await import('../utils/portManager.js');
    const config = services[name];

    if (!config) {
      res.status(404).json({ error: `Service ${name} not found` });
      return;
    }

    // Use absolute path from config instead of relative path
    await execAsync(
      `cd ${config.cwd} && docker compose -f docker-compose.dev.yml up -d`
    );

    res.json({ success: true, message: 'Container started' });
  } catch (error) {
    logger.error({
      category: 'api',
      action: 'error_starting_container_error',
      message: `Error starting container: ${error}`,
      error
    });
    res.status(500).json({
      error: error instanceof Error ? error.message : String(error)
    });
  }
});

// Stop docker container
router.post('/services/:name/docker/stop-container', async (req: Request, res: Response) => {
  const { name } = req.params;

  if (name !== 'python-worker') {
    res.status(400).json({ error: 'Docker operations only supported for python-worker' });
    return;
  }

  try {
    logger.info({
      category: 'api',
      action: 'stopping_docker_container_for_name',
      message: `Stopping docker container for ${name}`
    });
    const containerNames = ['job-finder-local-dev', 'job-finder-dev'];
    for (const containerName of containerNames) {
      await stopDockerContainer(containerName);
    }

    res.json({ success: true, message: 'Container stopped' });
  } catch (error) {
    logger.error({
      category: 'api',
      action: 'error_stopping_container_error',
      message: `Error stopping container: ${error}`,
      error
    });
    res.status(500).json({
      error: error instanceof Error ? error.message : String(error)
    });
  }
});

// Restart worker process inside container
router.post('/services/:name/docker/restart-worker', async (req: Request, res: Response) => {
  const { name } = req.params;

  if (name !== 'python-worker') {
    res.status(400).json({ error: 'Docker operations only supported for python-worker' });
    return;
  }

  try {
    logger.info({
      category: 'api',
      action: 'restarting_worker_process_in_docker_container_for_name',
      message: `Restarting worker process in docker container for ${name}`
    });
    const { execAsync } = await import('../utils/portManager.js');
    const containerNames = ['job-finder-local-dev', 'job-finder-dev'];

    let restarted = false;
    for (const containerName of containerNames) {
      try {
        // Kill the queue_worker.py process
        await execAsync(
          `docker exec ${containerName} pkill -f queue_worker.py`
        );

        // The container's command will restart it automatically
        restarted = true;
        logger.info({
      category: 'api',
      action: 'worker_process_restarted_in_container_containername',
      message: `Worker process restarted in container ${containerName}`
    });
        break;
      } catch (error) {
        // Try next container name
      }
    }

    if (restarted) {
      res.json({ success: true, message: 'Worker process restarted' });
    } else {
      res.status(404).json({ error: 'No running container found' });
    }
  } catch (error) {
    logger.error({
      category: 'api',
      action: 'error_restarting_worker_error',
      message: `Error restarting worker: ${error}`,
      error
    });
    res.status(500).json({
      error: error instanceof Error ? error.message : String(error)
    });
  }
});

// Get logs for a service
router.get('/services/:serviceName/logs', (req: Request, res: Response) => {
  try {
    const { serviceName } = req.params;
    const lines = parseInt(req.query.lines as string) || 100;
    // Use LogWatcher for file-based log reading
    const logWatcher = processManager.getLogWatcher();
    const logs = logWatcher.getRecentLogs(serviceName, lines);
    res.json({ serviceName, logs });
  } catch (error) {
    logger.error({
      category: 'api',
      action: 'error_getting_logs_for_req_params_servicename_error',
      message: `Error getting logs for ${req.params.serviceName}: ${error}`,
      error
    });
    res.status(500).json({
      error: 'Failed to get logs',
      message: error instanceof Error ? error.message : String(error),
    });
  }
});

