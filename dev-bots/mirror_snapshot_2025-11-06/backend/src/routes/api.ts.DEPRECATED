router.post('/claude-workers/workspace-sync/trigger', async (req: Request, res: Response) => {
  try {
    const { dryRun, verbose, conflictStrategy } = req.body;
    
    const syncResult = await claudeWorkersManager.triggerWorkspaceSync({
      dryRun: dryRun || false,
      verbose: verbose || false,
      conflictStrategy: conflictStrategy || 'auto-merge'
    });
    
    res.json({ 
