// Retry a failed task
router.post('/claude-workers/tasks/:taskId/retry', async (req: Request, res: Response) => {
  try {
    const { taskId } = req.params;
    const { reason } = req.body;
    
    const result = await claudeWorkersManager.retryTask(taskId, reason);
    
    if (result.success) {
      res.json({
        success: true,
        message: result.message
      });
    } else {
      res.status(400).json({
        success: false,
        error: result.message
      });
    }
  } catch (error) {
    logger.error({
      category: 'api',
      action: 'error_retrying_task_error',
      message: `Error retrying task: ${error}`,
      error
    });
    res.status(500).json({
      error: 'Failed to retry task',
      message: error instanceof Error ? error.message : String(error),
    });
  }
});

