# Claude Workers Environment Variables
# Copy this file to .env and fill in your actual values

# Configure optional tooling tokens here if needed.
# Claude credentials are read-only and mounted from ~/.claude/.credentials.json.
# Dev-bots will copy that file into their isolated workspace; they never modify the host context.

# Optional: Your GitHub Token (for private repo read access)
GITHUB_TOKEN=your-github-token-here

# Environment
NODE_ENV=production
